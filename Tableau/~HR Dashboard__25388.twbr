    <dashboard enable-sort-zone-taborder='true' name='HR | Details'>
      <style />
      <size maxheight='800' maxwidth='1400' minheight='800' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='dataset' name='federated.0504dih0p3k7wz1fgrhvc043pf4p' />
      </datasources>
      <datasource-dependencies datasource='federated.0504dih0p3k7wz1fgrhvc043pf4p'>
        <column caption='Full Name' datatype='string' name='[Calculation_0157814342856706]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[First Name] + &apos;&apos; + [Last Name]' />
        </column>
        <column caption='Length of Hire' datatype='integer' name='[Calculation_0157814449324039]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='IF ISNULL ([Termdate])&#13;&#10;THEN DATEDIFF(&apos;year&apos;, [Hiredate], TODAY())&#13;&#10;ELSE DATEDIFF(&apos;year&apos;, [Hiredate], [Termdate])&#13;&#10;END' />
        </column>
        <column caption='Status' datatype='string' name='[Calculation_0720485285113856]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF ISNULL([Termdate]) THEN &apos;Hired&apos;&#13;&#10;ELSE &apos;Terminated&apos;&#13;&#10;END' />
        </column>
        <column caption='Location' datatype='string' name='[Calculation_1235880558428165]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [State]&#13;&#10;    WHEN &apos;New York&apos; THEN &apos;HQ&apos; &#13;&#10;    ELSE &apos;Branch&apos; &#13;&#10;END' />
        </column>
        <column caption='Age Groups' datatype='string' name='[Calculation_1235880870592521]' role='dimension' semantic-role='' type='nominal'>
          <calculation class='tableau' formula='IF [Calculation_1235880869093384] &lt; 25 THEN &apos;&gt;25&apos;&#13;&#10;ELSEIF [Calculation_1235880869093384] &gt;=25 AND [Calculation_1235880869093384] &lt; 35 THEN &apos;25-34&apos;&#13;&#10;ELSEIF [Calculation_1235880869093384] &gt;=35 AND [Calculation_1235880869093384] &lt; 45 THEN &apos;35-44&apos;&#13;&#10;ELSEIF [Calculation_1235880869093384] &gt;=45 AND [Calculation_1235880869093384] &lt; 55 THEN &apos;45-54&apos;&#13;&#10;ELSEIF [Calculation_1235880869093384] &gt;=55 THEN &apos;55+&apos;&#13;&#10;END' />
        </column>
        <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column datatype='string' name='[Department]' role='dimension' type='nominal' />
        <column datatype='string' name='[Education Level]' role='dimension' type='nominal'>
          <aliases>
            <alias key='&quot;High School&quot;' value='H-Sch' />
          </aliases>
        </column>
